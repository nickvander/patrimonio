# Patrimonio Environment Configuration
# Copy this to .env and fill in your values

# Database
# Generate a strong password and use it everywhere — docker-compose
# refuses to start if POSTGRES_PASSWORD is unset. The DATABASE_URL the
# Rust API consumes is built from this value, so they stay in lockstep.
#   openssl rand -base64 32
POSTGRES_PASSWORD=
DATABASE_URL=postgres://patrimonio:${POSTGRES_PASSWORD}@localhost:5432/patrimonio
DATABASE_MAX_CONNECTIONS=10

# Redis
# Redis holds session tokens + in-flight WebAuthn state, so it requires a
# password. docker-compose passes REDIS_PASSWORD to both `redis-server
# --requirepass` and the api's REDIS_URL, so set a strong value here.
#   openssl rand -hex 24
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6380
REDIS_PORT=6380

# PostgreSQL host port for docker-compose
POSTGRES_PORT=5433

# Bind addresses for the DB and Redis port-forwards. Loopback only by
# default so a casual `docker compose up` doesn't put Postgres on the
# LAN. Set to 0.0.0.0 only if you actively need external access.
POSTGRES_BIND=127.0.0.1
REDIS_BIND=127.0.0.1

# Server
API_PORT=8080
FRONTEND_PORT=3000
PORT=8080
FRONTEND_BASE_URL=http://localhost:3000
# CORS now runs with credentials enabled — wildcard "*" is rejected.
# List exactly the origins your browser will use.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Force the session cookie's Secure flag on. Default is true; explicitly
# set to false ONLY for local http://localhost development. In any
# deployment served over https the cookie should stay Secure (it's also
# marked Secure automatically when FRONTEND_BASE_URL is https://).
COOKIE_SECURE=true

# Plaid (get keys from https://dashboard.plaid.com)
# Use sandbox for local test data. Use development/production only after the
# Plaid dashboard app, products, redirect/webhook URLs, and secrets are ready.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Public HTTPS URL of the /api/institutions/webhook route. Required for
# Plaid Production to push transaction updates instead of forcing the
# app to poll. Leave blank for local sandbox dev.
#   PLAID_WEBHOOK_URL=https://patrimonio.example.com/api/institutions/webhook
PLAID_WEBHOOK_URL=
# Android applicationId the native app is built with. Sent to Plaid as
# android_package_name (in place of redirect_uri) when the APK requests a
# link token, so OAuth banks (US Bank, etc.) return into the app. Register
# it under "Allowed Android package names" in the Plaid dashboard
# (Developers -> API). Defaults to com.patrimonio.patrimonio when blank.
PLAID_ANDROID_PACKAGE_NAME=

# Comma-separated CIDRs whose source IPs are allowed to set
# X-Forwarded-For / X-Real-IP on incoming requests. Empty in local dev
# (no upstream proxy → those headers get stripped, the TCP peer is
# trusted as the client). In production, set to your reverse-proxy's
# IP (and the docker bridge if the api container sits behind nginx):
#   TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.17.0.0/16
TRUSTED_PROXY_CIDRS=

# Exchange rate API (optional, free tier works without key)
# https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=

# Encryption key for sensitive data (generate a random 32-byte hex string)
# openssl rand -hex 32
ENCRYPTION_KEY=

# Coinbase OAuth (optional)
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=
COINBASE_REDIRECT_URI=http://localhost:8080/api/auth/coinbase/callback
