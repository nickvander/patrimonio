# Patrimonio Environment Configuration
# Copy this to .env and fill in your values

# Database
# Generate a strong password and use it everywhere — docker-compose
# refuses to start if POSTGRES_PASSWORD is unset. The DATABASE_URL the
# Rust API consumes is built from this value, so they stay in lockstep.
#   openssl rand -base64 32
POSTGRES_PASSWORD=
DATABASE_URL=postgres://patrimonio:${POSTGRES_PASSWORD}@localhost:5432/patrimonio
DATABASE_MAX_CONNECTIONS=10

# Redis
REDIS_URL=redis://localhost:6380
REDIS_PORT=6380

# PostgreSQL host port for docker-compose
POSTGRES_PORT=5433

# Bind addresses for the DB and Redis port-forwards. Loopback only by
# default so a casual `docker compose up` doesn't put Postgres on the
# LAN. Set to 0.0.0.0 only if you actively need external access.
POSTGRES_BIND=127.0.0.1
REDIS_BIND=127.0.0.1

# Server
API_PORT=8080
FRONTEND_PORT=3000
PORT=8080
FRONTEND_BASE_URL=http://localhost:3000
# CORS now runs with credentials enabled — wildcard "*" is rejected.
# List exactly the origins your browser will use.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Force the session cookie's Secure flag on. Default is true; explicitly
# set to false ONLY for local http://localhost development. In any
# deployment served over https the cookie should stay Secure (it's also
# marked Secure automatically when FRONTEND_BASE_URL is https://).
COOKIE_SECURE=true

# Plaid (get keys from https://dashboard.plaid.com)
# Use sandbox for local test data. Use development/production only after the
# Plaid dashboard app, products, redirect/webhook URLs, and secrets are ready.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Exchange rate API (optional, free tier works without key)
# https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=

# Encryption key for sensitive data (generate a random 32-byte hex string)
# openssl rand -hex 32
ENCRYPTION_KEY=

# Coinbase OAuth (optional)
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=
COINBASE_REDIRECT_URI=http://localhost:8080/api/auth/coinbase/callback
