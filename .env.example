# Patrimonio Environment Configuration
# Copy this to .env and fill in your values

# Database (defaults work with docker-compose)
DATABASE_URL=postgres://patrimonio:patrimonio@localhost:5432/patrimonio
DATABASE_MAX_CONNECTIONS=5

# Redis
REDIS_URL=redis://localhost:6380
REDIS_PORT=6380

# PostgreSQL host port for docker-compose
POSTGRES_PORT=5433

# Server
API_PORT=8080
FRONTEND_PORT=3000
PORT=8080
FRONTEND_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Plaid (get keys from https://dashboard.plaid.com)
# Leave empty until Phase 2
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Exchange rate API (optional, free tier works without key)
# https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=

# Encryption key for sensitive data (generate a random 32-byte hex string)
# openssl rand -hex 32
ENCRYPTION_KEY=

# Coinbase OAuth (optional)
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=
COINBASE_REDIRECT_URI=http://localhost:8080/api/auth/coinbase/callback
