<?xml version="1.0" encoding="utf-8"?>
<!--
  Patrimonio home-screen widget.
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  Every row is independently GONE-able: the provider hides whichever sections
  the user switched off in Settings, and the remaining rows close up because
  this is a vertical LinearLayout with no fixed positions. `widget_empty` is
  the all-off case — a widget rendering nothing reads as broken, so it says
  what to do instead.

  All text arrives PREFORMATTED from Dart (see utils/home_widget_snapshot.dart).
  Nothing here formats money: RemoteViews has no access to the reporting
  currency or the locale, and a second formatter would drift from the app.
-->
<!--
  The roomy two-line layout. RESIZE-ONLY: no appwidget-provider names it as an
  initialLayout any more (the 4x2 picker entry was dropped — see
  PatrimonioWidgetSizes.kt). PatrimonioWidgetProvider.layoutFor swaps to it
  once a widget is dragged past ~90dp tall.

  The root FILLS its cell with content vertically CENTRED. The original bug
  here looked like a fill problem — a 3x2 tile with a large empty white void
  below three lines of text — but the real fault was the forced 3x2 size
  (minHeight made 1 row unreachable) combined with TOP-aligned content.
  Wrapping the card fixed the void and introduced a subtler one: a short pill
  floating inside a taller cell, unlike every other widget on the home screen.
  Filling + centring is what the size fix made correct.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:elevation="4dp"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_net_worth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:contentDescription="@string/widget_net_worth_label" />

        <!-- Opens the app, which syncs and then re-pushes this widget. The
             widget itself never touches the network: no session cookie in
             native code, no WorkManager, no R8 surface. -->
        <ImageView
            android:id="@+id/widget_sync"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:background="@drawable/widget_icon_bg"
            android:tint="@color/widget_icon_tint"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="@string/widget_sync_label" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_fx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_accent"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- See the compact layout's note: the trend is what fills a 2-row cell
         with content instead of card. -->
    <ImageView
        android:id="@+id/widget_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/widget_synced_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_text_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="@string/widget_all_hidden"
        android:textColor="@color/widget_text_muted"
        android:textSize="12sp" />
</LinearLayout>
