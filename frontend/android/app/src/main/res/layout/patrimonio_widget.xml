<?xml version="1.0" encoding="utf-8"?>
<!--
  Patrimonio home-screen widget.
  ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
  Every row is independently GONE-able: the provider hides whichever sections
  the user switched off in Settings, and the remaining rows close up because
  this is a vertical LinearLayout with no fixed positions. `widget_empty` is
  the all-off case — a widget rendering nothing reads as broken, so it says
  what to do instead.

  All text arrives PREFORMATTED from Dart (see utils/home_widget_snapshot.dart).
  Nothing here formats money: RemoteViews has no access to the reporting
  currency or the locale, and a second formatter would drift from the app.
-->
<!--
  NOTE `layout_height="wrap_content"`, not match_parent. A widget root that
  matches its parent paints the card across the ENTIRE allocated cell area
  while the content sits at the top — which is exactly how this shipped: a
  3x2 tile with three lines of text and a large empty white void beneath.
  Wrapping makes the card hug its content, so an over-tall placement just
  leaves transparent space instead of a stretched card.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_net_worth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:contentDescription="@string/widget_net_worth_label" />

        <!-- Opens the app, which syncs and then re-pushes this widget. The
             widget itself never touches the network: no session cookie in
             native code, no WorkManager, no R8 surface. -->
        <ImageView
            android:id="@+id/widget_sync"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="@string/widget_sync_label" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_fx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_synced_at"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_text_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="@string/widget_all_hidden"
        android:textColor="@color/widget_text_muted"
        android:textSize="12sp" />
</LinearLayout>
