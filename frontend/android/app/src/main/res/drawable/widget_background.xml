<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded card matching the app's 20dp card idiom (pre-31 fallback; the
     v31 variant uses the system widget radius). The 1dp hairline stroke is
     the M3 outlined-surface depth cue — real blurred drop shadows are not
     expressible in a shape drawable, and hosts often clip elevation shadows,
     so the outline is the reliable part and android:elevation on the layout
     root is the best-effort part. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_background" />
    <stroke android:width="1dp" android:color="@color/widget_outline" />
    <corners android:radius="20dp" />
</shape>
